{
  "expo": {
    "name": "Trend Leader",
    "slug": "trend-leader",
    "icon": "./assets/images/icon.png",
    "scheme": "trendleader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trendleader.capstone",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.trendleader.capstone",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4abf29e-32f7-477e-933b-a02bef83e9c1"
      }
    },
    "owner": "darklight0418s-team"
  }
}
