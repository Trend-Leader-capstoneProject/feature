APP_NAME=Trend Leader API
APP_ENV=local
DEBUG=true
API_PREFIX=/api

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=input_here
DB_USER=input_here
DB_PASSWORD=input_here

# 로컬 개발에서는 비워두고 위의 DB_* 설정 사용 권장
# 운영 환경에서 완성된 URL을 주입할 때만 사용
DATABASE_URL=

# Demo Seed 전용 독립 승인값 (기본 승인 없음, 일반 API에는 미설정 가능)
# 관리자 승인 후 주석을 해제하고 입력. DB_* / DATABASE_URL에서 자동 복사 금지.
# Windows에서 접근하는 리터럴 TCP Host와 명시적 Port를 사용합니다.
# DEMO_SEED_ALLOWED_HOST=
# DEMO_SEED_ALLOWED_PORT=
# DEMO_SEED_ALLOWED_DATABASE=
# DEMO_SEED_ALLOWED_CURRENT_USER=
# CURRENT_USER()의 user@host 전체값이며 API 전용 계정과 혼동하지 않습니다.

# SQLAlchemy Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECTION_TIMEOUT=5

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=client
GOOGLE_CLIENT_SECRET=client

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=API_key
GEMINI_API_KEY=API_key

# CORS
CORS_ORIGINS=http://localhost:8081
